---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import Servicos from '../components/Servicos.astro';
import Videos from '../components/Videos.astro';
import Blog from '../components/Blog.astro';
import Contato from '../components/Contato.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { hasBlogPosts } from '../lib/sanity';

// Só mostra o blog (seção e link na navegação) se houver posts reais no Sanity
const showBlog = await hasBlogPosts();
---

<BaseLayout>
  <Navbar showBlog={showBlog} />
  <main id="main-content" style="padding-top: 6rem;">
    <Hero />
    <Sobre />
    <Servicos />
    <Videos />
    {showBlog && <Blog />}
    <Contato />
  </main>
  <Footer />
  <WhatsAppButton />
</BaseLayout>
