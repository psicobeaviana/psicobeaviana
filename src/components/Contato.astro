---
import { whatsappLink } from '../config';
---

<section
  id="contato"
  style="padding-block: var(--spacing-section-gap); padding-inline: var(--spacing-margin-mobile); margin-bottom: var(--spacing-section-gap);"
>
  <div
    class="relative overflow-hidden rounded-3xl border soft-shadow text-center soft-shadow"
    style="max-width: 48rem; margin-inline: auto; background-color: var(--color-surface-container-low); padding: clamp(2.5rem, 5vw, 4rem); border-color: color-mix(in srgb, var(--color-outline-variant) 30%, transparent);"
  >
    <!-- Decoração de fundo -->
    <div
      class="absolute rounded-full blur-2xl -z-0"
      style="width: 8rem; height: 8rem; top: -3rem; right: -3rem; background-color: color-mix(in srgb, var(--color-primary-container) 20%, transparent);"
    ></div>
    <div
      class="absolute rounded-full blur-2xl -z-0"
      style="width: 8rem; height: 8rem; bottom: -3rem; left: -3rem; background-color: color-mix(in srgb, var(--color-secondary-container) 40%, transparent);"
    ></div>

    <h2
      class="font-display relative"
      style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; color: var(--color-primary); margin-bottom: 1.5rem; letter-spacing: -0.02em;"
    >
      Dê o primeiro passo
    </h2>

    <p
      class="font-body relative"
      style="font-size: 1.125rem; line-height: 1.6; color: var(--color-on-surface-variant); margin-bottom: 2.5rem; max-width: 36rem; margin-inline: auto;"
    >
      Agende uma conversa inicial para entendermos juntos como a psicoterapia pode auxiliar no seu momento atual.
    </p>

    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-3 font-body soft-shadow relative"
      style="background-color: var(--color-primary-container); color: white; padding: 1rem 2rem; border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.05em; text-decoration: none; transition: transform 0.3s;"
    >
      <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">chat</span>
      Agendar via WhatsApp
    </a>
  </div>
</section>
