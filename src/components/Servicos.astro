---
import { getImage } from 'astro:assets';
import bateriaTestes from '/public/images/bateria-de-testes.jpeg';
import psicoterapiaCardImg from '/public/images/psicoterapia-card.jpeg';

interface Servico {
  icon: string;
  title: string;
  description: string;
  items: string[];
  image: string;
  imageAlt: string;
  imagePosition?: string;
}

const psicoterapiaImg = await getImage({
  src: psicoterapiaCardImg,
  width: 540,
  height: 360,
  format: 'webp',
  quality: 80,
});

const neuropsicologiaImg = await getImage({
  src: bateriaTestes,
  width: 540,
  height: 360,
  format: 'webp',
  quality: 80,
});

const servicos: Servico[] = [
  {
    icon: 'psychology',
    title: 'Psicoterapia e Psicanálise',
    description:
      'Um processo profundo de autoconhecimento guiado pela escuta analítica. Foco em compreender padrões inconscientes, tratar sintomas de ansiedade, depressão e promover o bem-estar emocional contínuo.',
    items: ['Sessões semanais', 'Online ou Presencial'],
    image: psicoterapiaImg.src,
    imageAlt: 'Representação de psicoterapia com poltrona confortável em luz natural',
    imagePosition: 'center 60%',
  },
  {
    icon: 'neurology',
    title: 'Avaliação Neuropsicológica',
    description:
      'Investigação detalhada das funções cognitivas (memória, atenção, linguagem) e comportamentais. Auxilia em diagnósticos diferenciais, planejamento de reabilitação e compreensão do funcionamento cerebral.',
    items: ['Bateria de testes padronizados', 'Entrega de laudo completo'],
    image: neuropsicologiaImg.src,
    imageAlt: 'Bateria de testes de avaliação neuropsicológica',
    imagePosition: 'center 20%',
  },
];
---

<section
  id="servicos"
  aria-label="Serviços"
  style="padding-block: var(--spacing-section-gap); padding-inline: var(--spacing-margin-mobile); max-width: var(--spacing-container-max); margin-inline: auto;"
>
  <div class="text-center mb-16">
    <span
      class="font-body uppercase tracking-wider"
      style="font-size: 0.875rem; font-weight: 600; letter-spacing: 0.05em; color: var(--color-tertiary);"
    >
      Especialidades
    </span>
    <h2
      class="font-display mt-2"
      style="font-size: clamp(1.75rem, 3vw, 2rem); font-weight: 600; line-height: 1.2; color: var(--color-primary);"
    >
      Como posso te ajudar
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
    {servicos.map((servico) => (
      <article
        class="group flex flex-col gap-6 rounded-3xl border soft-shadow"
        style="background-color: var(--color-surface-container-lowest); padding: 2rem; border-color: color-mix(in srgb, var(--color-outline-variant) 30%, transparent); transition: transform 0.3s;"
      >
        <div class="h-64 overflow-hidden" style="border-radius: 2.5rem 0.75rem 2.5rem 0.75rem;">
          <img
            src={servico.image}
            alt={servico.imageAlt}
            class="w-full h-full object-cover"
            style={`transition: transform 0.5s; object-position: ${servico.imagePosition ?? 'center 20%'};`}
          />
        </div>

        <div class="flex items-center gap-3" style="color: var(--color-primary);">
          <span class="material-symbols-outlined" style="font-size: 1.875rem;">{servico.icon}</span>
          <h3 class="font-display" style="font-size: 1.25rem; font-weight: 600;">{servico.title}</h3>
        </div>

        <p class="font-body" style="font-size: 1rem; line-height: 1.6; color: var(--color-on-surface-variant);">
          {servico.description}
        </p>

        <ul class="space-y-2 font-body" style="font-size: 1rem; line-height: 1.6; color: var(--color-on-surface-variant); list-style: none; padding: 0; margin: 0;">
          {servico.items.map((item) => (
            <li class="flex items-center gap-2">
              <span class="rounded-full" style="width: 6px; height: 6px; background-color: var(--color-primary-container); flex-shrink: 0;"></span>
              {item}
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
