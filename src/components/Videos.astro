---
import { getVideos } from '../lib/sanity';

// Fallback hardcoded caso o Sanity esteja vazio ou indisponível.
const fallbackReels = [
  'https://www.instagram.com/reel/Dbx8tqJvcae/',
  'https://www.instagram.com/reel/DcB9-QNvwU-/',
  'https://www.instagram.com/reel/DcZXMqWvW9G/',
];

// Tenta buscar vídeos do Sanity; fallback para lista local.
let reels: string[] = [];

try {
  const sanityVideos = await getVideos();
  if (sanityVideos.length > 0) {
    reels = sanityVideos.map((v) => v.url);
  }
} catch {
  // fallback
}

if (reels.length === 0) {
  reels = fallbackReels;
}
---

<section
  id="video"
  aria-label="Vídeos"
  style="padding-block: var(--spacing-section-gap); padding-inline: var(--spacing-margin-mobile); max-width: var(--spacing-container-max); margin-inline: auto; margin-bottom: var(--spacing-section-gap);"
>
  <div class="text-center mb-12">
    <span
      class="font-body uppercase tracking-wider"
      style="font-size: 0.875rem; font-weight: 600; letter-spacing: 0.05em; color: var(--color-tertiary);"
    >
      Além da Teoria
    </span>
    <h2
      class="font-display mt-2"
      style="font-size: clamp(1.75rem, 3vw, 2rem); font-weight: 600; line-height: 1.2; color: var(--color-primary);"
    >
      Insights em Vídeo
    </h2>
  </div>

  <!-- Carrossel -->
  <div class="relative" data-carousel>
    <!-- Seta esquerda -->
    <button
      type="button"
      data-carousel-prev
      aria-label="Vídeo anterior"
      class="carousel-arrow hidden md:flex"
      style="left: -1.25rem;"
    >
      <span class="material-symbols-outlined">chevron_left</span>
    </button>

    <!-- Trilho com scroll horizontal -->
    <div
      data-carousel-track
      class="flex gap-8 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4"
      style="scrollbar-width: none; justify-content: center;"
    >
      {reels.map((reel) => (
        <div class="snap-center shrink-0" style="flex: 0 0 auto; width: min(100%, 340px);">
          <blockquote
            class="instagram-media w-full"
            data-instgrm-permalink={`${reel}?utm_source=ig_embed&utm_campaign=loading`}
            data-instgrm-version="14"
            style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:1px auto; max-width:540px; min-width:326px; padding:0; width:100%;"
          >
            <div style="padding:16px;">
              <a
                href={`${reel}?utm_source=ig_embed&utm_campaign=loading`}
                style="background:#FFFFFF; line-height:0; padding:0; text-align:center; text-decoration:none; width:100%;"
                target="_blank"
                rel="noopener noreferrer"
              >
                Ver no Instagram
              </a>
            </div>
          </blockquote>
        </div>
      ))}
    </div>

    <!-- Seta direita -->
    <button
      type="button"
      data-carousel-next
      aria-label="Próximo vídeo"
      class="carousel-arrow hidden md:flex"
      style="right: -1.25rem;"
    >
      <span class="material-symbols-outlined">chevron_right</span>
    </button>
  </div>
</section>

<style>
  /* Esconde a scrollbar mantendo o scroll funcional */
  [data-carousel-track]::-webkit-scrollbar {
    display: none;
  }

  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-full);
    background-color: var(--color-surface-container-lowest);
    color: var(--color-primary);
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 40%, transparent);
    box-shadow: 0px 10px 30px rgba(140, 115, 101, 0.12);
    cursor: pointer;
    transition: background-color 0.2s, transform 0.2s;
  }

  .carousel-arrow:hover {
    background-color: var(--color-primary-container);
    color: white;
  }

  /* Oculta a seta desabilitada (início/fim do trilho) */
  .carousel-arrow[disabled] {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  function initCarousels() {
    const carousels = document.querySelectorAll('[data-carousel]');

    carousels.forEach((carousel) => {
      const track = carousel.querySelector('[data-carousel-track]') as HTMLElement | null;
      const prev = carousel.querySelector('[data-carousel-prev]') as HTMLButtonElement | null;
      const next = carousel.querySelector('[data-carousel-next]') as HTMLButtonElement | null;
      if (!track || !prev || !next) return;

      // Distância de deslize = largura visível do trilho (~1 "página" de vídeos)
      const scrollAmount = () => track.clientWidth * 0.9;

      const updateArrows = () => {
        const maxScroll = track.scrollWidth - track.clientWidth - 1;
        // Sem overflow: sem necessidade de setas
        const hasOverflow = track.scrollWidth > track.clientWidth + 1;
        // Centraliza quando os vídeos cabem; alinha à esquerda quando há scroll
        // (justify-center com overflow cortaria o primeiro item)
        track.style.justifyContent = hasOverflow ? 'flex-start' : 'center';
        prev.style.display = hasOverflow ? 'flex' : 'none';
        next.style.display = hasOverflow ? 'flex' : 'none';
        prev.disabled = track.scrollLeft <= 0;
        next.disabled = track.scrollLeft >= maxScroll;
      };

      prev.addEventListener('click', () => {
        track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });

      next.addEventListener('click', () => {
        track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });

      track.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows);

      // Recalcula quando os embeds do Instagram terminam de carregar (mudam a largura)
      const observer = new ResizeObserver(updateArrows);
      observer.observe(track);

      updateArrows();
    });
  }

  // Executa no carregamento e em navegações internas do Astro
  initCarousels();
  document.addEventListener('astro:page-load', initCarousels);
</script>

<!-- Embed do Instagram -->
<script is:inline async src="https://www.instagram.com/embed.js"></script>
