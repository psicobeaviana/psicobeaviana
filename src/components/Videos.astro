---
// Permalinks dos Reels do Instagram.
// Para trocar ou adicionar vídeos, basta editar esta lista com a URL do reel.
const reels = [
  'https://www.instagram.com/reel/Dbx8tqJvcae/',
  'https://www.instagram.com/reel/DcB9-QNvwU-/',
  'https://www.instagram.com/reel/DcB9-QNvwU-/',
];
---

<section
  id="video"
  style="padding-block: var(--spacing-section-gap); padding-inline: var(--spacing-margin-mobile); max-width: var(--spacing-container-max); margin-inline: auto; margin-bottom: var(--spacing-section-gap);"
>
  <div class="text-center mb-12">
    <span
      class="font-body uppercase tracking-wider"
      style="font-size: 0.875rem; font-weight: 600; letter-spacing: 0.05em; color: var(--color-tertiary);"
    >
      Além da Teoria
    </span>
    <h2
      class="font-display mt-2"
      style="font-size: clamp(1.75rem, 3vw, 2rem); font-weight: 600; line-height: 1.2; color: var(--color-primary);"
    >
      Insights em Vídeo
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 justify-items-center">
    {reels.map((reel) => (
      <blockquote
        class="instagram-media w-full"
        data-instgrm-captioned
        data-instgrm-permalink={`${reel}?utm_source=ig_embed&utm_campaign=loading`}
        data-instgrm-version="14"
        style="background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin:1px auto; max-width:540px; min-width:326px; padding:0; width:100%;"
      >
        <div style="padding:16px;">
          <a
            href={`${reel}?utm_source=ig_embed&utm_campaign=loading`}
            style="background:#FFFFFF; line-height:0; padding:0; text-align:center; text-decoration:none; width:100%;"
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver no Instagram
          </a>
        </div>
      </blockquote>
    ))}
  </div>
</section>

<script is:inline async src="https://www.instagram.com/embed.js"></script>
