---
import { whatsappLink } from '../config';

const navLinks = [
  { href: '#home', label: 'Home' },
  { href: '#sobre', label: 'Sobre' },
  { href: '#servicos', label: 'Serviços' },
  { href: '#blog', label: 'Blog' },
  { href: '#contato', label: 'Contato' },
];
---

<!-- Navbar fixa — desktop usa flex, mobile mostra hamburger -->
<nav
  class="fixed w-full top-0 z-50 backdrop-blur-md border-b"
  style="background-color: color-mix(in srgb, var(--color-background) 80%, transparent); border-color: color-mix(in srgb, var(--color-outline-variant) 30%, transparent);"
>
  <div
    class="flex justify-between items-center w-full h-20"
    style="padding-inline: var(--spacing-margin-mobile); max-width: var(--spacing-container-max); margin-inline: auto;"
  >
    <!-- Logo -->
    <a href="#" style="text-decoration: none;">
      <span class="font-script" style="font-style: italic; font-weight: 400; font-size: 1.75rem; color: var(--color-primary);">Psicóloga Beatriz Viana</span>
    </a>

    <!-- Links + CTA (desktop) -->
    <div class="hidden md:flex items-center gap-8">
      <ul class="flex gap-6 list-none m-0 p-0" style="font-family: var(--font-body); font-size: 1rem;">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link transition-colors duration-300"
              style="color: var(--color-on-surface-variant); text-decoration: none;"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="font-body"
        style="background-color: var(--color-primary-container); color: var(--color-on-primary-container); padding: 0.5rem 1.5rem; border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.05em; text-decoration: none; transition: opacity 0.2s;"
      >
        Agendar Consulta
      </a>
    </div>

    <!-- Botão hamburger (mobile) -->
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-center items-center gap-1.5 p-2"
      style="background: none; border: none; cursor: pointer;"
      aria-label="Abrir menu de navegação"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <!-- Menu mobile (drawer) -->
  <div
    id="mobile-menu"
    class="md:hidden mobile-menu"
    aria-hidden="true"
  >
    <ul class="flex flex-col gap-2 list-none m-0 p-0">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link font-body"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href={whatsappLink}
      target="_blank"
      rel="noopener noreferrer"
      class="font-body mobile-cta"
    >
      Agendar Consulta
    </a>
  </div>
</nav>

<style>
  /* Linhas do hamburger */
  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  /* Animação X quando aberto */
  .menu-open .hamburger-line:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .menu-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  .menu-open .hamburger-line:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* Menu mobile */
  .mobile-menu {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease, padding 0.35s ease;
    padding: 0 var(--spacing-margin-mobile);
    border-top: 1px solid color-mix(in srgb, var(--color-outline-variant) 30%, transparent);
  }

  .mobile-menu.open {
    max-height: 400px;
    padding: 1.5rem var(--spacing-margin-mobile);
  }

  .mobile-nav-link {
    display: block;
    padding: 0.75rem 1rem;
    font-size: 1.125rem;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    border-radius: var(--radius-lg);
    transition: background-color 0.2s, color 0.2s;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus {
    background-color: var(--color-surface-container);
    color: var(--color-primary);
  }

  .mobile-cta {
    display: block;
    text-align: center;
    margin-top: 1rem;
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-container);
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .mobile-cta:hover {
    opacity: 0.85;
  }

  /* Desktop nav hover */
  .nav-link:hover {
    color: var(--color-primary);
  }

  @media (min-width: 768px) {
    nav > div:first-child {
      padding-inline: var(--spacing-margin-desktop);
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  toggle.addEventListener('click', () => {
    const isOpen = menu.classList.toggle('open');
    toggle.classList.toggle('menu-open', isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
    menu.setAttribute('aria-hidden', String(!isOpen));
  });

  // Fecha o menu ao clicar em um link
  menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.remove('open');
      toggle.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
    });
  });
</script>
