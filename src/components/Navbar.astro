---
const navLinks = [
  { href: '#home', label: 'Home' },
  { href: '#sobre', label: 'Sobre' },
  { href: '#servicos', label: 'Serviços' },
  { href: '#blog', label: 'Blog' },
  { href: '#contato', label: 'Contato' },
];
---

<nav
  class="fixed w-full top-0 z-50 backdrop-blur-md border-b hidden md:flex rounded-b-3xl"
  style="background-color: color-mix(in srgb, var(--color-background) 80%, transparent); border-color: color-mix(in srgb, var(--color-outline-variant) 30%, transparent);"
>
  <div
    class="flex justify-between items-center w-full h-20"
    style="padding-inline: var(--spacing-margin-desktop); max-width: var(--spacing-container-max); margin-inline: auto;"
  >
    <!-- Logo -->
    <a href="#" class="font-display" style="font-size: 1.5rem; font-weight: 600; color: var(--color-primary); text-decoration: none;">
      Psicóloga
      <span class="font-script" style="font-style: italic; font-weight: 400; font-size: 1.75rem;">Beatriz Viana</span>
    </a>

    <!-- Links + CTA -->
    <div class="flex items-center gap-8">
      <ul class="flex gap-6 list-none m-0 p-0" style="font-family: var(--font-body); font-size: 1rem;">
        {navLinks.map((link, i) => (
          <li>
            <a
              href={link.href}
              class="transition-colors duration-300"
              style={i === 0
                ? `color: var(--color-primary); font-weight: 700; border-bottom: 2px solid var(--color-primary); padding-bottom: 4px; text-decoration: none;`
                : `color: var(--color-on-surface-variant); text-decoration: none;`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href="#contato"
        class="font-body"
        style="background-color: var(--color-primary-container); color: var(--color-on-primary-container); padding: 0.5rem 1.5rem; border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.05em; text-decoration: none; transition: opacity 0.2s;"
      >
        Agendar Consulta
      </a>
    </div>
  </div>
</nav>

<!-- Mobile FAB WhatsApp -->
<a
  href="#contato"
  class="fixed bottom-8 right-8 md:hidden z-50 flex items-center gap-2 rounded-full p-4"
  style="background-color: var(--color-primary); color: var(--color-on-primary); box-shadow: 0px 10px 30px rgba(140,115,101,0.18);"
  aria-label="Agendar via WhatsApp"
>
  <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">chat</span>
</a>

<style>
  a:hover {
    color: var(--color-primary);
  }
</style>
