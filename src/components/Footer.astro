---
import { phoneDisplay, email, instagramUrl, whatsappLink, crp } from '../config';

// Ano atualizado automaticamente a cada build
const currentYear = new Date().getFullYear();
---

<footer
  aria-label="Rodapé"
  class="rounded-t-3xl border-t"
  style="background-color: var(--color-surface-container-low); padding-block: 4rem; border-color: color-mix(in srgb, var(--color-outline-variant) 20%, transparent);"
>
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-6 text-center md:text-left"
    style="padding-inline: var(--spacing-margin-desktop); max-width: var(--spacing-container-max); margin-inline: auto; gap: var(--spacing-gutter);"
  >
    <!-- Marca -->
    <div class="flex flex-col gap-4 items-center md:items-start">
      <span class="font-script" style="font-style: italic; font-weight: 400; font-size: 1.75rem; color: var(--color-primary);">Psicóloga Beatriz Viana</span>
      <p
        class="font-body"
        style="font-size: 1rem; line-height: 1.6; color: var(--color-on-surface-variant); max-width: 18rem;"
      >
        Promovendo saúde mental através da escuta atenta e do acolhimento terapêutico.
      </p>
      <p
        class="font-body"
        style="font-size: 0.875rem; color: var(--color-on-surface-variant);"
      >
        Atendimento em Sorocaba/SP
      </p>
    </div>

    <!-- Contato -->
    <div class="flex flex-col gap-4 items-center md:items-start">
      <h4
        class="font-body"
        style="font-size: 0.875rem; font-weight: 600; color: var(--color-on-background);"
      >
        Contato
      </h4>

      <a
        href={`mailto:${email}`}
        class="font-body"
        style="font-size: 1rem; color: var(--color-on-surface-variant); text-decoration: none; transition: color 0.2s;"
      >
        {email}
      </a>

      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="font-body"
        style="font-size: 1rem; color: var(--color-on-surface-variant); text-decoration: none; transition: color 0.2s;"
      >
        {phoneDisplay}
      </a>

      <div class="flex gap-4 mt-2">
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          style="color: var(--color-on-surface-variant); transition: color 0.2s;"
        >
          <span class="material-symbols-outlined">photo_camera</span>
        </a>
        <a
          href={`mailto:${email}`}
          aria-label="E-mail"
          style="color: var(--color-on-surface-variant); transition: color 0.2s;"
        >
          <span class="material-symbols-outlined">mail</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div
    class="text-center mt-12 pt-8 border-t font-body"
    style="font-size: 1rem; color: var(--color-on-surface-variant); border-color: color-mix(in srgb, var(--color-outline-variant) 20%, transparent);"
  >
    © {currentYear} Psicóloga Beatriz Viana. {crp}. Todos os direitos reservados.
  </div>
</footer>
